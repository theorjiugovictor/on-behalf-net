# Both services are optional. With neither set, the app runs on deterministic
# local behaviour: the floor still negotiates, traversal still returns results.
# Copy to .env.local and fill in what you have.

# --- Nebius Token Factory / AI Studio (reasoning with NVIDIA open-source models) ---
# Key from https://studio.nebius.com/ — uses NVIDIA Nemotron series (e.g. nvidia/nemotron-3-super-120b-a12b or nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B)
NEBIUS_API_KEY=
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1
NEBIUS_TIMEOUT_MS=20000

# --- Tavily (traversal) ---
# Key from https://app.tavily.com/
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_TIMEOUT_MS=20000

# --- This node ---
# The absolute base URL other agents should reach this node on. Set this in any
# deployed environment; agent cards advertise it as their endpoint.
OBN_PUBLIC_URL=http://localhost:3000
